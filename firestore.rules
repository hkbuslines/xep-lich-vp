rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Nội bộ công ty, không có đăng nhập: cho đọc/ghi tự do collection "schedules".
    // Đây KHÔNG phải bảo mật thật sự — ai có link đều sửa được. Nếu cần chặn người ngoài,
    // xem mục "Bảo mật thêm (tuỳ chọn)" trong README.md để bật Firebase Auth.
    match /schedules/{docId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
