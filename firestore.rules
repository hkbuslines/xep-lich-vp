rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Nội bộ công ty, không có đăng nhập: cho đọc/ghi tự do collection "schedules".
    // Đây KHÔNG phải bảo mật thật sự — ai có link đều sửa được. Nếu cần chặn người ngoài,
    // xem mục "Bảo mật thêm (tuỳ chọn)" trong README.md để bật Firebase Auth.
    match /schedules/{docId} {
      allow read, write: if true;
    }
    // Danh sách nhân viên (roster) — ghi đè office.teams[].people tĩnh trong offices-data.js, sửa
    // qua modal "Danh sách nhân viên" trên office.html. Cùng mức bảo mật như "schedules" ở trên.
    match /rosters/{docId} {
      allow read, write: if true;
    }
    // Bảng thông báo "xe đã đến sân bay" (arrival.html). Doc "roster_<ngày>" do
    // script fleet_odoo/bus_qa/airport_board.py ghi (kéo từ Odoo); doc
    // "arrivals_<ngày>" do nhân viên bấm tay trên trang. Cùng mức bảo mật như
    // "schedules"/"rosters" ở trên.
    match /airport_board/{docId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
